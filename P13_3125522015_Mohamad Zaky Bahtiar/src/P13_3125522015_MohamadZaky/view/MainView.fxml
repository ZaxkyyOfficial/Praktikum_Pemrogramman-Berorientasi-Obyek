<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.image.ImageView?>

<BorderPane fx:id="rootPane" prefWidth="1360.0" prefHeight="820.0"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="P13_3125522015_MohamadZaky.controller.MainController">

    <left>
        <VBox styleClass="sidebar" spacing="8.0">
            <HBox styleClass="sidebar-brand-box" spacing="12.0" alignment="CENTER_LEFT">
                <ImageView fx:id="logoImageView" fitWidth="48.0" fitHeight="48.0" preserveRatio="true"/>
                <VBox spacing="2.0">
                    <Label text="BADAN GIZI NASIONAL" styleClass="sidebar-title"/>
                    <Label text="Sistem Manajemen MBG" styleClass="sidebar-subtitle"/>
                    <Label text="P12 - 3125522015" styleClass="sidebar-subtitle"/>
                </VBox>
            </HBox>

            <Label text="MODUL OPERASIONAL" styleClass="sidebar-section-label"/>

            <Button fx:id="btnNavDashboard" text="1. Dashboard &amp; Polimorfisme" maxWidth="Infinity"
                    styleClass="nav-button, nav-button-active" onAction="#tampilkanDashboard"/>
            <Button fx:id="btnNavInventaris" text="2. Inventaris &amp; Validasi Stok" maxWidth="Infinity"
                    styleClass="nav-button" onAction="#tampilkanInventaris"/>
            <Button fx:id="btnNavMenuGizi" text="3. Menu &amp; Pengelola ArrayList" maxWidth="Infinity"
                    styleClass="nav-button" onAction="#tampilkanMenuGizi"/>
            <Button fx:id="btnNavDistribusi" text="4. Distribusi &amp; Pelacakan" maxWidth="Infinity"
                    styleClass="nav-button" onAction="#tampilkanDistribusi"/>
            <Button fx:id="btnNavSekolah" text="5. Data Sekolah Penerima" maxWidth="Infinity"
                    styleClass="nav-button" onAction="#tampilkanSekolah"/>

            <Region VBox.vgrow="ALWAYS"/>

            <VBox styleClass="sidebar-brand-box" spacing="4.0">
                <Label text="STATUS BASIS DATA" styleClass="sidebar-subtitle"/>
                <Label fx:id="lblSidebarDbStatus" text="Memeriksa koneksi..." wrapText="true" styleClass="sidebar-title"/>
                <Label text="Data berlabel [Simulasi] untuk evaluasi PBO Modul 11 (Collection ArrayList)" wrapText="true" styleClass="sidebar-subtitle"/>
            </VBox>
        </VBox>
    </left>

    <center>
        <BorderPane>
            <top>
                <HBox styleClass="topbar" alignment="CENTER_LEFT" spacing="16.0">
                    <VBox spacing="2.0" HBox.hgrow="ALWAYS">
                        <Label fx:id="lblHeaderTitle" text="Dashboard Operasional Program Makan Bergizi Gratis" styleClass="page-title"/>
                        <Label fx:id="lblHeaderSubtitle" text="Pengelolaan Kumpulan Objek Domain MBG Berbasis Generics dan ArrayList [P11]" styleClass="page-subtitle"/>
                    </VBox>
                    <Button fx:id="btnMuatUlangData" text="Sinkronkan Data SQL" styleClass="btn-secondary" onAction="#sinkronkanDatabase"/>
                    <Button fx:id="btnTemaToggle" text="Mode Tampilan: Terang" styleClass="btn-secondary" onAction="#toggleTema"/>
                </HBox>
            </top>
            <center>
                <StackPane fx:id="contentArea" style="-fx-padding: 18px;"/>
            </center>
        </BorderPane>
    </center>
</BorderPane>

